# Meta Cloud API
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_PATIENT_CONSENT_TEMPLATE=sanko_patient_consent_v1
WHATSAPP_PATIENT_CONSENT_LANGUAGE=en
# App secret from Meta Developer Console → App settings → Basic.
# Used to verify webhook signatures (X-Hub-Signature-256). REQUIRED in production:
# with NODE_ENV=production and this unset the webhook refuses every request, rather
# than accepting forged ones. Outside production an unsigned request is still
# allowed, so a local run needs no Meta app.
META_APP_SECRET=your_meta_app_secret_here

# Inbound message recovery (019), for both the Meta webhook and the Baileys adapter.
# A message accepted but never answered — the process died mid-turn — is re-enqueued
# once it has been outstanding this long.
# Must exceed AGENT_TURN_LEASE_SECONDS, or a slow turn is mistaken for a dead one
# and the practitioner is answered twice. Default: max(900, lease x 1.5).
# INBOUND_RECOVERY_AFTER_SECONDS=900
# How many times one message may be retried before it is given up on and logged
# at error level. Stops a message that crashes the process from doing it forever.
# INBOUND_RECOVERY_MAX_ATTEMPTS=3
# How often the sweep runs. The grace period above, not this, is what protects a
# turn that is merely slow.
# INBOUND_RECOVERY_INTERVAL_MS=300000

# Accept unsigned webhooks in production anyway. Only for a deployment that has
# genuinely decided to run without signature verification and knows that anyone
# who finds the URL can then write a formulation into a practitioner's Vault.
# ALLOW_UNSIGNED_WEBHOOKS=true

# Baileys local WhatsApp test adapter (unofficial WhatsApp Web connection).
# Link a spare/test WhatsApp account, then allow only the number(s) that may
# exercise the agent. Comma-separated E.164 numbers; use * only deliberately.
BAILEYS_ALLOWED_NUMBERS=+447700900123
BAILEYS_AUTH_DIR=.baileys-auth

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Model providers ──────────────────────────────────────────────────────────
# 'ollama'    — runs on this machine; no practitioner data leaves the host
# 'anthropic' — hosted API; kept as an eval baseline (`npm run eval -- --compare`)
LLM_PROVIDER=ollama

# Ollama (local agent)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:32b-instruct-q4_K_M
# Ollama's default context silently truncates the agent's system prompt. Keep this high.
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT_MS=300000

# How long Ollama keeps the model in RAM between turns. Ollama's default is 5
# minutes, which means most WhatsApp conversations would open with a ~3 minute
# model reload the practitioner experiences as silence. '-1' = keep loaded.
OLLAMA_KEEP_ALIVE=-1

# Reading photographed notebook pages.
# The agent model above is text-only: Ollama accepts an images array for it and
# silently ignores the pixels, so a page has to be read by a vision model first
# and handed to the agent as text. Pull one before enabling this:
#   ollama pull qwen2.5vl:7b
#
# 'ollama'    — on this machine; the page never leaves the host
# 'anthropic' — hosted, an eval baseline for how far behind local reading is
# 'off'       — no reading; photos are archived and the agent is told it cannot read them
# Candidates worth measuring against your own pages before settling on one —
# every published OCR benchmark is printed documents, not handwriting, and none
# of them contain Yoruba, Igbo or Hausa. `npm run vision:compare` scores them.
#   glm-ocr        2.2 GB  dedicated OCR, tiny, top of OmniDocBench
#   qwen3.5:27b     17 GB  general VLM, strong document understanding
#   qwen2.5vl:7b   ~6 GB   the original default
VISION_BACKEND=ollama
VISION_MODEL=qwen2.5vl:7b
VISION_ANTHROPIC_MODEL=claude-sonnet-4-6
VISION_TIMEOUT_MS=300000

# Safe default: formulation documentation and account-rights tools only.
# Patient tools require BOTH AGENT_TOOLS=full and PATIENT_TRACKING_ENABLED=true.
AGENT_TOOLS=vault
PATIENT_TRACKING_ENABLED=false

# The contributor terms in governance/ are a DRAFT with no legal review and no
# practitioner consultation. While this is false the agent never raises them and
# an acceptance cannot be recorded at all. Turn it on only once both have
# happened — registration itself does not depend on it, and a practitioner who
# declines keeps every part of Sanko.
CONTRIBUTOR_TERMS_IN_FORCE=false

# Whisper.
# 'cli'  — openai/whisper via its command line (pip install -U openai-whisper).
#          Simplest to install and the ecosystem you fine-tune in; slower on
#          Apple Silicon because it barely uses Metal.
# 'http' — any OpenAI-compatible /v1/audio/transcriptions endpoint. whisper.cpp's
#          `whisper-server` is the fast local option; api.openai.com is the baseline.
# Either way ffmpeg must be installed — openai/whisper shells out to it to decode audio.
WHISPER_BACKEND=cli

# cli backend
# Use large-v3 for Yoruba, Igbo or Hausa audio — the smaller checkpoints saw very
# little of these languages and transcribe them badly. English is fine on medium.
WHISPER_CLI_MODEL=large-v3      # tiny|base|small|medium|large-v3, or a fine-tuned path
WHISPER_DEVICE=                 # blank = auto; 'cpu' is the reliable choice on M1
WHISPER_TIMEOUT_MS=600000

# http backend
WHISPER_BASE_URL=http://127.0.0.1:8080/v1
WHISPER_MODEL=whisper-1
WHISPER_TRANSCODE=true          # ogg/opus → 16 kHz mono WAV before upload

# Whisper's language argument forces the decoder rather than hinting to it.
#   auto    never force; detect, and flag a detection that contradicts the profile
#   prefer  force the language the practitioner explicitly chose, if they chose one
# Neither ever forces a language the practitioner has not stated.
WHISPER_LANGUAGE_MODE=auto

# Only needed when WHISPER_BASE_URL points at OpenAI
OPENAI_API_KEY=

# Only needed for LLM_PROVIDER=anthropic, or `npm run eval -- --compare`
ANTHROPIC_API_KEY=

# App
PORT=3000
NODE_ENV=development

# /admin and /simulator — HTTP Basic Auth (username is always 'felix')
ADMIN_PASSWORD=choose_a_strong_password_here

# Share link for /simulator, so someone can try the agent without your password
# and without reaching /admin:  /simulator?as=<name>&t=<GUEST_TOKEN>
# Each ?as= name gets its own conversation, pinned — a guest cannot open another's.
# Leave blank to disable guest access entirely.
GUEST_TOKEN=

# Agent
AGENT_MODEL=claude-sonnet-4-6

# Message aggregation: how long to wait for more messages before answering.
# The window restarts on each new message; MAX_WAIT is the hard ceiling.
AGGREGATION_WINDOW_MS=2500
AGGREGATION_MAX_WAIT_MS=10000

# ─── Operator accounts (/admin, /simulator) ──────────────────────────────────
# Allowlisted operators. Every write from the control room is attributed to the
# REF of whoever signed in — never to a value typed into a form. Generate an
# entry with:  npm run admin:account -- <username> <REF>
# Format: username:REF:scrypt$salt$hash , separated by ";"
ADMIN_ACCOUNTS=
# Legacy single shared password. Still accepted, but actions taken with it are
# attributed to OP-LEGACY rather than to a person. Remove it once every operator
# has an ADMIN_ACCOUNTS entry.
# ADMIN_PASSWORD=
# Pseudonymous reference used by the CLI scripts (plant confirmations, model
# promotions), which cannot authenticate the way /admin can.
SANKO_OPERATOR_REF=

# ─── Backups ─────────────────────────────────────────────────────────────────
# 32 bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy OFF this machine. Losing it makes every backup unreadable, which
# is exactly the situation backups exist for.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Postgres connection string, for migrations and backups. Derived from
# SUPABASE_URL automatically when that points at this machine.
SUPABASE_DB_URL=
# Only needed if pg_dump on this host is older than the server and no Supabase
# container is running.
# PG_DUMP_PATH=

# ─── Logging and alerting ────────────────────────────────────────────────────
LOG_LEVEL=info
# Blank in production writes JSON lines; set true for human-readable output.
# LOG_PRETTY=
# Any endpoint that accepts a JSON POST (Slack, Discord, ntfy, your own).
# Error-level events are sent here, throttled so one outage cannot send a
# thousand alerts. Blank disables alerting.
ALERT_WEBHOOK_URL=
ALERT_WINDOW_MS=900000
ALERT_MAX_PER_WINDOW=12

# ─── Turn queue ──────────────────────────────────────────────────────────────
# One local model serves one turn at a time; raise only for a backend that
# genuinely serves in parallel.
AGENT_CONCURRENCY=1
# How long a practitioner waits before being told the bot is working on it.
AGENT_QUEUE_ACK_MS=4000
AGENT_QUEUE_MAX_DEPTH=40
AGENT_QUEUE_MAX_WAIT_MS=600000
# Cross-instance turn lease (migration 012). Must exceed the slowest honest turn.
AGENT_TURN_LEASE_SECONDS=600
