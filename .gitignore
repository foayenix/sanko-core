node_modules/
.env
.env.*
# The template of required variables — placeholders only, never real values.
!.env.example
*.log
.DS_Store
.baileys-auth/

# Eval scorecards — regenerate with `npm run eval`. Keep one deliberately if you
# want a committed baseline to diff future runs against.
evals/results/*.json

# Training artefacts. These contain practitioner transcripts — never commit them.
# Ignored as a whole rather than by naming each artefact directory, so the next one
# is covered the day someone creates it instead of the day someone remembers. The
# documentation is exempted back in: it is the part that should be readable.
training/*
!training/*.md

# Source-extraction scratch. Holds full text and page scans of copyrighted books
# (Iwu 2014, Oliver-Bever 1986) pulled in to build the plant provenance data.
# Only the staged metadata under data/plants/ is safe to commit — never this.
tmp/

# whisper.cpp GGML weights (multi-GB, fetched not committed)
models/

# The unknown-plant review queue. Built by `npm run plants:pull`, it carries the
# practitioner speech a reviewer needs in order to identify a name — never commit
# it. `npm run plants:promote` copies the confirmed mapping alone into
# data/plants/practitioner_confirmations.json, which is safe to commit.
data/plants/review_queue.json

# Concise facts and page locators extracted from Iwu 2014 and Oliver-Bever 1986,
# staged as review evidence for an inclusion decision. Both works are copyrighted
# and no redistribution permission was identified, so they stay beside the page
# scans in tmp/ rather than entering history — private repositories get forked,
# and git remembers after visibility changes. Nothing under data/plants/ that
# feeds the runtime index lives here.
data/plants/references/staged/

# The build report counts those staged records among its totals, so its contents
# depend on review evidence that is deliberately not committed. Generated by
# `npm run plants:build`; the runtime index it reports on is committed, and that
# is the artefact reproducibility actually turns on.
data/plants/build_report.json

# Eval cases drafted from real corrections. They contain verbatim, un-de-identified
# practitioner speech until a person reviews them; only a reviewed case, moved up
# into evals/cases/, is safe to commit. The runner ignores this directory.
evals/cases/drafts/

# Review packets and the decisions file a practitioner fills in. Generated from
# the cases, and the decisions file carries a reviewer's working notes — the
# approval itself belongs in the case, which is where `eval-review.js apply`
# writes it.
evals/review/

# Encrypted database dumps. Encrypted is not a licence to commit them: the
# manifest alone records row counts, and a key that ever leaks makes every
# committed dump readable forever.
backups/

# Runtime output from development and local service processes. *.log above catches
# most of it; this covers the .out and .pids files left beside them, and anything
# a future script drops here. Agent logs carry practitioner speech.
logs/

# Vercel
.vercel
